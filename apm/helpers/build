#!/usr/bin/env bash

set -e

if [ -z "$DEPENDABOT_NATIVE_HELPERS_PATH" ]; then
  echo "Unable to build, DEPENDABOT_NATIVE_HELPERS_PATH is not set"
  exit 1
fi

install_dir="$DEPENDABOT_NATIVE_HELPERS_PATH/apm"

if ! [[ "$install_dir" =~ ^/ ]]; then
  echo "$install_dir must be an absolute path"
  exit 1
fi

# See https://github.com/microsoft/apm/releases
apm_version="0.35.1"

# Checksums come from the `<asset>.sha256` files published with each release.
case "$(uname -m)" in
  x86_64 | amd64)
    apm_arch="x86_64"
    apm_checksum="e7f06b9c80e26152ab579fe50d7dcd3d76ebbd8eacd44eed424e39880044eb3e"
    ;;
  aarch64 | arm64)
    apm_arch="arm64"
    apm_checksum="96d65f6ed385d4c4c6093257e9f083bd3e4b51617c228abd787def92c18ab429"
    ;;
  *)
    echo "Unsupported architecture: $(uname -m)"
    exit 1
    ;;
esac

apm_asset="apm-linux-${apm_arch}"
apm_url="https://github.com/microsoft/apm/releases/download/v${apm_version}/${apm_asset}.tar.gz"
tarball="$(mktemp)"

curl -sSLfo "$tarball" "$apm_url"
echo "$apm_checksum  $tarball" | sha256sum -c
rm -rf "${install_dir:?}/dist"
mkdir -p "$install_dir/dist" "$install_dir/bin"
tar -xzf "$tarball" -C "$install_dir/dist"
rm -f "$tarball"

# The release is a PyInstaller bundle: the `apm` executable must stay next to
# its `_internal` directory, so expose it on a stable path through a symlink.
ln -sf "$install_dir/dist/$apm_asset/apm" "$install_dir/bin/apm"

echo "Verifying APM installation..."
"$install_dir/bin/apm" --version
