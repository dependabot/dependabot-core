#!/usr/bin/env bash

set -e

run_native_specs() (
  # Mocked registry metadata must not leak into later bundle installs.
  cache_dir="$(mktemp -d)" || exit
  trap 'rm -rf -- "$cache_dir"' EXIT
  export BUNDLE_USER_CACHE="$cache_dir"
  bundle exec rspec spec
)

bundle install
bundle exec turbo_tests2 --verbose

# NOTE: Don't use `if` branches without `else` part, since the code in some of
# then seems to not abort the script regardless of `set -e`

# shellcheck source=../helpers/v2/build
DEPENDABOT_NATIVE_HELPERS_PATH="" source helpers/v2/build \
  && run_native_specs \
  && cd -

# shellcheck source=../helpers/v4/build
DEPENDABOT_NATIVE_HELPERS_PATH="" source helpers/v4/build \
  && run_native_specs \
  && cd -
