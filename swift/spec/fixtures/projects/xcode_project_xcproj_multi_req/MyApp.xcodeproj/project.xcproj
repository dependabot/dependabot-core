{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-nio.git",
      "version": {
        "up-to-next-major-version": "2.54.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-collections.git",
      "version": {
        "up-to-next-minor-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-argument-parser",
      "version": {
        "version": "1.2.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-log.git",
      "version": {
        "version-range": "1.4.0..<2.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/swiftlang/swift-syntax.git",
      "version": {
        "version-range-min": "600.0.0-prerelease-2024-06-12",
        "version-range-max": "601.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-algorithms.git",
      "version": {
        "branch": "main",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-numerics.git",
      "version": {
        "revision": "0a5bc04095a675662cf24757cc0640aa2204253b",
      },
    }, {
      "kind": "local",
      "path": "LocalPackage",
    },
  ],
  "files": [
    { "kind": "folder", "path": "MyApp", "target-membership": [ "MyApp" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/MyApp", "id": "A30000000000000000000001", "type": "compiled.mach-o.executable", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "MyApp",
      "id": "A70000000000000000000001",
      "product": "Products/MyApp",
      "product-type": "tool",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "build-settings": {
        "PRODUCT_NAME": "$(TARGET_NAME)",
      },
    },
  ],
  "build-settings": {
    "MACOSX_DEPLOYMENT_TARGET": "14.0",
    "SDKROOT": "macosx",
    "SWIFT_VERSION": "5.0",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "27.0",
}
