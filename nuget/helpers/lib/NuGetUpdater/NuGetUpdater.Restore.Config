<!-- Build-only sources; fixture repositories must not inherit these mappings. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-tools">
      <package pattern="Microsoft.Build" />
      <package pattern="Microsoft.Build.Framework" />
      <package pattern="Microsoft.Build.Tasks.Core" />
      <package pattern="Microsoft.Build.Utilities.Core" />
      <package pattern="Microsoft.NET.StringTools" />
    </packageSource>
  </packageSourceMapping>
</configuration>
