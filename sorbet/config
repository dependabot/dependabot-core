--dir=.
--ignore=tmp/
--ignore=vendor/
--ignore=.bundle/
--ignore=bin
--disable-watchman
--suppress-payload-superclass-redefinition-for=RDoc::Markup::Heading
--enable-experimental-rspec
# Shared example modules inherit matcher/mock methods through ExampleGroup.
--enable-experimental-requires-ancestor

# Sorbet's RSpec support is experimental, so spec trees are checked incrementally
# while unenrolled spec trees are ignored.
--ignore=apm/spec/
--ignore=bazel/spec/
--ignore=bun/spec/
--ignore=bundler/helpers/
--ignore=bundler/spec/
--ignore=cargo/spec/
--ignore=composer/spec/
--ignore=deno/spec/
--ignore=elm/spec/
--ignore=github_actions/spec/
--ignore=go_modules/spec/
--ignore=helm/spec/
--ignore=hex/spec/
--ignore=julia/spec/
--ignore=nix/spec/
--ignore=nuget/spec/
--ignore=pre_commit/spec/
--ignore=pub/spec/
--ignore=rust_toolchain/spec/
--ignore=swift/spec/
--ignore=terraform/spec/
--ignore=opentofu/spec/
--ignore=updater/spec/
--ignore=vcpkg/spec/
--ignore=.git
