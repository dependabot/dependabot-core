  def call(result, coverage_limits:); end

  # pkg:gem/simplecov#lib/simplecov/exit_codes/exit_code_handling.rb:22
  def coverage_checks(result, coverage_limits); end

  class << self
    # pkg:gem/simplecov#lib/simplecov/exit_codes/exit_code_handling.rb:10
    def call(result, coverage_limits:); end

    # pkg:gem/simplecov#lib/simplecov/exit_codes/exit_code_handling.rb:22
