  # pkg:gem/simplecov#lib/simplecov/result/missing_source_files_reporter.rb:36
  def partial_missing_warning; end

  # pkg:gem/simplecov#lib/simplecov/result/missing_source_files_reporter.rb:42
  def summary; end
end

