  # Turns an interned table back into the tuple-keyed hash the rest of
  # SimpleCov reads. Done once, at the end of a fold.
  #
  # @return [Hash]
  #
  # pkg:gem/simplecov#lib/simplecov/combine/branches_combiner.rb:61
