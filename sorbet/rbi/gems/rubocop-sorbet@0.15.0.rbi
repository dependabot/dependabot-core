# @example
#   # bad
#   yielding_method do
#     def bad(args)
#       # ...
#     end
#   end
#
#   # bad
#   Class.new do
#     def bad(args)
#       # ...
#     end
#   end
#
#   # good
#   yielding_method do
#     define_method(:good) do |args|
#       # ...
#     end
#   end
#
#   # good
#   MyClass = Class.new do
#     def good(args)
#       # ...
#     end
#   end
#
#   # good
