#!/bin/bash

set -e

# Builds the native helper. Requires the Clojure CLI, which is only installed
# in the helper-build stage of clojure/Dockerfile.
helpers_dir="$(dirname "${BASH_SOURCE[0]}")/../helpers"

if [ -z "$DEPENDABOT_NATIVE_HELPERS_PATH" ]; then
  export DEPENDABOT_NATIVE_HELPERS_PATH="/opt"
fi

bash "$helpers_dir/build"
