defmodule DependabotTest.Mixfile do
  use Mix.Project

  def project do
    [
      app: :dependabot_test,
      version: "0.1.0",
      elixir: "~> 1.5",
      aliases: ["deps.update": &reject_deps_update/1],
      deps: deps()
    ]
  end

  def application do
    [extra_applications: [:logger]]
  end

  defp reject_deps_update(_args) do
    Mix.raise("project deps.update alias must not run")
  end

  defp deps do
    [
      {:plug, "~> 1.3.0"},
      {:phoenix, "~> 1.2.1"}
    ]
  end
end